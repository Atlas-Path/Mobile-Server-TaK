.DS_Store
.takserver-local.env

# IDE/build output that is generated locally in this checkout.
**/.classpath
**/.project
**/.settings/
**/bin/

# Gradle build output. Scoped to the top-level modules under src/ on purpose:
# a blanket **/build/ would also swallow vendored JS under federation-hub-ui.
/src/.gradle/
/src/*/build/
/src/takserver-package/CI_ENV_VARS

# Generated by setup-takserver.sh — private keys, keystores, and configs with
# passwords in them. Must never be committed.
/src/takserver-core/scripts/certs/files/
/src/takserver-core/example/certs/
/src/takserver-core/example/CoreConfig.xml
/src/takserver-core/example/TAKIgniteConfig.xml
/src/takserver-core/example/UserAuthenticationFile.xml

# Runtime output from start-tak.sh.
/src/takserver-core/example/start-tak.sh
/src/takserver-core/example/stop-tak.sh
/src/takserver-core/example/tak-runtime/
/src/takserver-core/example/logs/
/src/takserver-core/example/*.log
